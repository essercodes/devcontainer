{
    "name": "Neovim Config",
    "id": "neovim-config",
    "version": "0.1.0",
    "dependsOn": {
        "ghcr.io/devcontainers/features/common-utils:2": {},
        "ghcr.io/devcontainers/features/rust": {},
        "ghcr.io/devcontainers/features/python": {},
        "ghcr.io/devcontainers/features/node": {},
        "ghcr.io/essercodes/devcontainer/opencode": {},
        "ghcr.io/essercodes/devcontainer/neovim": {}
    },
    "description": "A feature to install neovim configuration",
    "options": {
        "username": {
            "type": "string",
            "default": "automatic",
            "description": "User to install the config for. 'automatic' uses the dev container's remoteUser."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils:2",
        "ghcr.io/devcontainers/features/rust",
        "ghcr.io/devcontainers/features/python",
        "ghcr.io/devcontainers/features/node",
        "ghcr.io/essercodes/devcontainer/opencode",
        "ghcr.io/essercodes/devcontainer/neovim"
    ]
}
