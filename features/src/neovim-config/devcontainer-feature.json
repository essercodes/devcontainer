{
    "name": "Neovim Config",
    "id": "neovim-config",
    "version": "0.1.1",
    "dependsOn": {
        "ghcr.io/devcontainers/features/common-utils:2": {},
        "ghcr.io/devcontainers/features/rust": {},
        "ghcr.io/devcontainers/features/python": {},
        "ghcr.io/devcontainers/features/node": {},
        "ghcr.io/essercodes/devcontainer/opencode": {},
        "ghcr.io/essercodes/devcontainer/neovim": {}
    },
    "description": "A feature to install neovim configuration",
    "options": {
        "configurl": {
            "type": "string",
            "default": "https://github.com/essercodes/neovim-config",
            "description": "URL to git repo containing neovim config"
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils:2",
        "ghcr.io/devcontainers/features/rust",
        "ghcr.io/devcontainers/features/python",
        "ghcr.io/devcontainers/features/node",
        "ghcr.io/essercodes/devcontainer/opencode",
        "ghcr.io/essercodes/devcontainer/neovim"
    ]
}
