{
	"image": "ubuntu:${templateOption:imageVariant}",
	"features": {
        "ghcr.io/essercodes/devcontainer/claudecode": {},
        "ghcr.io/essercodes/devcontainer/tmux": {},
        "ghcr.io/essercodes/devcontainer/neovim-config": {
            "configurl": "${templateOption:neovimConfigUrl}"
    },
	"remoteUser": "{templateOption:remoteUser}",
    "initializeCommand": "op --account my.1password.com inject -i .devcontainer/env.tpl -o .devcontainer/.env --force",
    "postStartCommand": "rm -f ${containerWorkspaceFolder}/.env.development",
    "runArgs": ["--env-file", ".devcontainer/.env"]
}
}
